    "    layer_3 = pretrained.layer3[3 : len(pretrained.layer3)](layer_3)\n",
    "    layer_4 = pretrained.layer4[3 : len(pretrained.layer4)](layer_4)\n",
    "\n",
    "    return layer_1, layer_2, layer_3, layer_4\n"
