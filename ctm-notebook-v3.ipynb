    "activations = {}\n",
    "\n",
    "def get_activation(name):\n",
    "    def hook(model, input, output):\n",
    "        activations[name] = output\n",
    "\n",
    "    return hook\n",
    "\n",
    "def _make_vit_b16_backbone(\n",
    "    model,\n",
