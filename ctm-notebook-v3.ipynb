    "            out_channels=features[0],\n",
    "            kernel_size=1,\n",
    "            stride=1,\n",
    "            padding=0,\n",
    "        ),\n",
    "        nn.ConvTranspose2d(\n",
    "            in_channels=features[0],\n",
    "            out_channels=features[0],\n",
    "            kernel_size=4,\n",
    "            stride=4,\n",
    "            padding=0,\n",
    "            bias=True,\n",
    "            dilation=1,\n",
    "            groups=1,\n",
