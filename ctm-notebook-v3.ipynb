    "        ),\n",
    "        nn.ConvTranspose2d(\n",
    "            in_channels=features[1],\n",
    "            out_channels=features[1],\n",
    "            kernel_size=2,\n",
    "            stride=2,\n",
    "            padding=0,\n",
    "            bias=True,\n",
    "            dilation=1,\n",
    "            groups=1,\n",
    "        ),\n",
    "    )\n",
    "\n",
    "    pretrained.layer3 = nn.Sequential(\n",
