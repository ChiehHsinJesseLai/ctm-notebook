    "        layer_1 = unflatten(layer_1)\n",
    "    if layer_2.ndim == 3:\n",
    "        layer_2 = unflatten(layer_2)\n",
    "    if layer_3.ndim == 3:\n",
    "        layer_3 = unflatten(layer_3)\n",
    "    if layer_4.ndim == 3:\n",
